# ─── API Keys ──────────────────────────────────────────────────
# Copy this file to `.env` and fill in your keys.
# NEVER commit .env to version control.

# Omniversify unified API backend
OMNIVERSIFY_API_URL=http://localhost:9000

# Omniversify sub-services (public URLs — override only if self-hosting)
MOROCCO_DATE_API_URL=https://morocco-date-api.omniversify.com/api
TIFINAGH_API_URL=https://omniversify-tifinagh-dictionary-api.omniversify.com
OMNIVERSIFY_APP_URL=https://app.omniversify.com

# RAWG Video Games Database API
# Free tier: 20,000 requests/month
# Get your key: https://api.rawg.io/apidocs
RAWG_API_KEY=

# IGDB (Internet Games Database) — via Twitch OAuth
# More detailed than RAWG: themes, game modes, involved companies
# Register app: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# TMDB (movies/TV): https://www.themoviedb.org/settings/api
# TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Open Library (books): No key needed, 3 req/sec with User-Agent
# Jikan (anime/manga): No key needed, 3 req/sec
